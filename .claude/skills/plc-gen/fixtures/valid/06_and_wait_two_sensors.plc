[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, Y1:digital:producer, X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, X3:digital:consumer]
}

device start_button: sensor {
    purpose: "操作员启动按钮，触发双缸并行伸出流程",
    subtype: "push_button",
    debounce: 20ms
}

device valve_A: solenoid_valve {
    purpose: "驱动 A 缸伸出/缩回的气动电磁阀",
    response_time: 20ms
}

device valve_B: solenoid_valve {
    purpose: "驱动 B 缸伸出/缩回的气动电磁阀",
    response_time: 20ms
}

device cyl_A: cylinder {
    purpose: "与 B 缸同时伸出的 A 气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

device cyl_B: cylinder {
    purpose: "与 A 缸同时伸出的 B 气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

device sensor_A_ext: sensor {
    purpose: "检测 A 缸已完全伸出到位的限位开关",
    subtype: "limit_switch"
}

device sensor_B_ext: sensor {
    purpose: "检测 B 缸已完全伸出到位的限位开关",
    subtype: "limit_switch"
}

device sensor_ok: sensor {
    purpose: "检测 A 缸伸出后工件就位的确认传感器",
    subtype: "limit_switch"
}

relation { from: start_button.out, to: plc_main.X3, via: reports_to }
relation { from: plc_main.Y0, to: valve_A.coil, via: driven_by }
relation { from: plc_main.Y1, to: valve_B.coil, via: driven_by }
relation { from: valve_A.out, to: cyl_A.cmd, via: driven_by }
relation { from: valve_B.out, to: cyl_B.cmd, via: driven_by }
relation { from: cyl_A.extended, to: sensor_A_ext.sense, via: detects }
relation { from: sensor_A_ext.out, to: plc_main.X0, via: reports_to }
relation { from: cyl_B.extended, to: sensor_B_ext.sense, via: detects }
relation { from: sensor_B_ext.out, to: plc_main.X1, via: reports_to }
relation { from: cyl_A.extended, to: sensor_ok.sense, via: detects }
relation { from: sensor_ok.out, to: plc_main.X2, via: reports_to }

[constraints]

causality: Y0 -> valve_A -> cyl_A -> sensor_A_ext
causality: Y1 -> valve_B -> cyl_B -> sensor_B_ext

[tasks]

task cycle:
    step extend_both:
        action: extend cyl_A
        action: extend cyl_B
    step wait_both:
        wait: sensor_A_ext == true AND sensor_B_ext == true
        timeout: 1200ms -> goto fault_handler
    step finish:
        wait: sensor_ok == true
        timeout: 1200ms -> goto fault_handler
    on_complete: goto ready

task fault_handler:
    step safe:
        action: retract cyl_A
        action: retract cyl_B
    step alarm:
        action: log "fault: AND wait timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
