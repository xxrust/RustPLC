{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RP2040 abnormal-exit evidence",
  "type": "object",
  "required": [
    "class",
    "trigger",
    "observed_outputs",
    "checks",
    "verdict",
    "artifacts"
  ],
  "properties": {
    "class": {
      "type": "string",
      "enum": ["A", "B", "C", "D"]
    },
    "trigger": {
      "type": "object",
      "required": ["method", "source"],
      "properties": {
        "method": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "observed_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "value", "order", "source"],
        "properties": {
          "channel": {
            "type": "string"
          },
          "value": {},
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "object"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "manual"]
    },
    "artifacts": {
      "type": "object",
      "required": ["trigger_log", "output_log"],
      "properties": {
        "trigger_log": {
          "type": "string"
        },
        "output_log": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "class_d_manual": {
      "type": "object",
      "required": [
        "trigger",
        "wiring_state",
        "measured_result",
        "verdict",
        "operator",
        "attachments"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "wiring_state": {
          "type": "string",
          "minLength": 1
        },
        "measured_result": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path", "provenance"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "provenance": {
                "type": "object",
                "required": ["source_path"],
                "properties": {
                  "source_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest_sha256": {
                    "type": "string"
                  },
                  "captured_by": {
                    "type": "string"
                  },
                  "captured_at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "const": "D"
          }
        }
      },
      "then": {
        "required": ["class_d_manual"]
      }
    }
  ]
}
