{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustplc.local/schemas/run-provenance.schema.json",
  "title": "RustPLC Delivery Run Provenance",
  "oneOf": [
    { "$ref": "#/$defs/legacy_v1" },
    { "$ref": "#/$defs/attributed_v2" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "legacy_v1": {
      "type": "object",
      "required": ["schema_version", "project_id", "run_id", "unattended_verdict"],
      "properties": {
        "schema_version": { "const": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "unattended_verdict": { "const": "not_proven" }
      }
    },
    "attributed_v2": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "project_id",
        "run_id",
        "source_commit",
        "git_base_commit",
        "dirty_worktree_at_start",
        "started_at_utc",
        "completed_at_utc",
        "provenance_scope",
        "execution_unattended_verdict",
        "source_authoring_verdict",
        "input_manifest",
        "models",
        "agents",
        "task_definitions",
        "skills",
        "tool_versions",
        "file_attribution",
        "unattended_verdict"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "project_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_worktree_at_start": { "type": "boolean" },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "completed_at_utc": { "type": "string", "format": "date-time" },
        "unattended_verdict": {
          "enum": ["proven", "not_proven", "human_intervention_detected"]
        },
        "provenance_scope": {
          "enum": [
            "delivery_fixture_materialization",
            "source_generation",
            "source_authoring_and_delivery_fixture_materialization"
          ]
        },
        "execution_unattended_verdict": {
          "enum": ["proven", "not_proven", "human_intervention_detected"]
        },
        "source_authoring_verdict": {
          "enum": ["proven", "not_proven"]
        },
        "input_manifest": { "$ref": "#/$defs/artifact_binding" },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "model"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 }
            }
          }
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["agent_id", "model", "role"],
            "properties": {
              "agent_id": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "task_definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "agent_id"],
            "properties": {
              "task_id": { "type": "string", "minLength": 1 },
              "agent_id": { "type": "string", "minLength": 1 },
              "task_kind": {
                "enum": [
                  "source_authoring",
                  "source_generation",
                  "materialization",
                  "validation"
                ]
              }
            }
          }
        },
        "skills": { "$ref": "#/$defs/versioned_components" },
        "tool_versions": { "$ref": "#/$defs/versioned_components" },
        "file_attribution": {
          "type": "object",
          "required": [
            "policy_version",
            "human_intervention_detected",
            "summary",
            "records",
            "evidence_envelopes"
          ],
          "properties": {
            "policy_version": { "const": "rustplc-file-attribution-v1" },
            "human_intervention_detected": { "type": "boolean" },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/file_attribution_record" }
            },
            "evidence_envelopes": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["path", "reason"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "versioned_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact_binding": {
      "type": "object",
      "required": ["artifact_ref", "digest", "source_commit", "freshness"],
      "properties": {
        "artifact_ref": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "object",
          "required": ["algorithm", "value", "normalization"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "$ref": "#/$defs/sha256" },
            "normalization": { "const": "utf8_lf" }
          }
        },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "freshness": {
          "type": "object",
          "required": ["status", "basis"]
        }
      }
    },
    "file_attribution_record": {
      "type": "object",
      "required": [
        "path",
        "before_sha256",
        "after_sha256",
        "attribution_kind",
        "basis"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "before_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "after_sha256": { "$ref": "#/$defs/sha256" },
        "attribution_kind": {
          "enum": [
            "agent_generated",
            "agent_modified",
            "pre_existing_user_change",
            "human_intervention_detected"
          ]
        },
        "agent_id": { "type": ["string", "null"] },
        "task_id": { "type": ["string", "null"] },
        "event_id": { "type": ["string", "null"] },
        "basis": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attribution_kind": {
                "enum": ["agent_generated", "agent_modified"]
              }
            }
          },
          "then": {
            "required": ["agent_id", "task_id"],
            "properties": {
              "agent_id": { "type": "string", "minLength": 1 },
              "task_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
