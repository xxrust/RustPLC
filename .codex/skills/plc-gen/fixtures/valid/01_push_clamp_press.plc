[topology]

device Y0: digital_output
device Y1: digital_output
device Y2: digital_output
device X0: digital_input
device X1: digital_input
device X2: digital_input
device X3: digital_input
device X4: digital_input
device X5: digital_input
device X6: digital_input

device start_button: sensor {
    debounce: 20ms
}

device valve_push: solenoid_valve {
    response_time: 20ms
}

device valve_clamp: solenoid_valve {
    response_time: 20ms
}

device valve_press: solenoid_valve {
    response_time: 20ms
}

device cyl_push: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device cyl_clamp: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device cyl_press: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device sensor_push_ext: sensor

device sensor_push_ret: sensor

device sensor_clamp_ext: sensor

device sensor_clamp_ret: sensor

device sensor_press_ext: sensor

device sensor_press_ret: sensor

relation { from: start_button.out, to: X6, via: reports_to }
relation { from: Y0, to: valve_push.coil, via: driven_by }
relation { from: Y1, to: valve_clamp.coil, via: driven_by }
relation { from: Y2, to: valve_press.coil, via: driven_by }
relation { from: valve_push.out, to: cyl_push.cmd, via: driven_by }
relation { from: valve_clamp.out, to: cyl_clamp.cmd, via: driven_by }
relation { from: valve_press.out, to: cyl_press.cmd, via: driven_by }
relation { from: sensor_push_ext.out, to: X0, via: reports_to }
relation { from: cyl_push.extended, to: sensor_push_ext.sense, via: detects }
relation { from: sensor_push_ret.out, to: X1, via: reports_to }
relation { from: cyl_push.retracted, to: sensor_push_ret.sense, via: detects }
relation { from: sensor_clamp_ext.out, to: X2, via: reports_to }
relation { from: cyl_clamp.extended, to: sensor_clamp_ext.sense, via: detects }
relation { from: sensor_clamp_ret.out, to: X3, via: reports_to }
relation { from: cyl_clamp.retracted, to: sensor_clamp_ret.sense, via: detects }
relation { from: sensor_press_ext.out, to: X4, via: reports_to }
relation { from: cyl_press.extended, to: sensor_press_ext.sense, via: detects }
relation { from: sensor_press_ret.out, to: X5, via: reports_to }
relation { from: cyl_press.retracted, to: sensor_press_ret.sense, via: detects }

[constraints]

safety: cyl_press.extended requires cyl_clamp.extended
    reason: "冲压缸动作时必须保持压紧"

causality: Y0 -> valve_push -> cyl_push -> sensor_push_ext
causality: Y1 -> valve_clamp -> cyl_clamp -> sensor_clamp_ext
causality: Y2 -> valve_press -> cyl_press -> sensor_press_ext

[tasks]

task cycle:
    step push_out:
        action: extend cyl_push
        wait: sensor_push_ext == true
        timeout: 1200ms -> goto fault_handler
    step clamp_down:
        action: extend cyl_clamp
        wait: sensor_clamp_ext == true
        timeout: 1200ms -> goto fault_handler
    step press_out:
        action: extend cyl_press
        wait: sensor_press_ext == true
        timeout: 1200ms -> goto fault_handler
    step press_back:
        action: retract cyl_press
        wait: sensor_press_ret == true
        timeout: 1200ms -> goto fault_handler
    step unclamp:
        action: retract cyl_clamp
        wait: sensor_clamp_ret == true
        timeout: 1200ms -> goto fault_handler
    step push_back:
        action: retract cyl_push
        wait: sensor_push_ret == true
        timeout: 1200ms -> goto fault_handler
    on_complete: goto ready

task fault_handler:
    step safe:
        action: retract cyl_press
        action: retract cyl_clamp
        action: retract cyl_push
    step alarm:
        action: log "fault: timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle

