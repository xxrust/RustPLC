[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, X3:digital:consumer]
}

device start_button: sensor {
    purpose: "操作员启动按钮，触发升降-确认循环",
    subtype: "push_button",
    debounce: 20ms
}

device confirm_button: sensor {
    purpose: "操作员确认按钮，人工确认工件就位后继续",
    subtype: "push_button",
    debounce: 20ms
}

device valve_lift: solenoid_valve {
    purpose: "驱动升降缸伸出/缩回的气动电磁阀",
    response_time: 20ms
}

device cyl_lift: cylinder {
    purpose: "将工件升起供操作员检查的升降气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

device sensor_lift_ext: sensor {
    purpose: "检测升降缸已完全伸出到位的限位开关",
    subtype: "limit_switch"
}

device sensor_lift_ret: sensor {
    purpose: "检测升降缸已完全缩回到位的限位开关",
    subtype: "limit_switch"
}

relation { from: start_button.out, to: plc_main.X3, via: reports_to }
relation { from: confirm_button.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: valve_lift.coil, via: driven_by }
relation { from: valve_lift.out, to: cyl_lift.cmd, via: driven_by }
relation { from: cyl_lift.extended, to: sensor_lift_ext.sense, via: detects }
relation { from: sensor_lift_ext.out, to: plc_main.X0, via: reports_to }
relation { from: cyl_lift.retracted, to: sensor_lift_ret.sense, via: detects }
relation { from: sensor_lift_ret.out, to: plc_main.X1, via: reports_to }

[constraints]

causality: Y0 -> valve_lift -> cyl_lift -> sensor_lift_ext

[tasks]

task cycle:
    step lift_up:
        action: extend cyl_lift
        wait: sensor_lift_ext == true
        timeout: 1200ms -> goto fault_handler
    step wait_operator_confirm:
        wait: confirm_button == true
        allow_indefinite_wait: true
    step lift_down:
        action: retract cyl_lift
        wait: sensor_lift_ret == true
        timeout: 1200ms -> goto fault_handler
    on_complete: goto ready

task fault_handler:
    step safe:
        action: retract cyl_lift
    step alarm:
        action: log "fault: lift timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
