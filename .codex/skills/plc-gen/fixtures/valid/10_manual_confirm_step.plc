[topology]

device plc_main: plc {
    purpose: "Controller profile for operator confirmation flow"
    model_ref: openplc_softplc
}

device start_button: sensor { purpose: "Operator start request", subtype: "push_button", debounce: 20ms }
device confirm_button: sensor { purpose: "Operator confirms the part is ready", subtype: "push_button", debounce: 20ms }
device valve_lift: solenoid_valve { purpose: "Lift cylinder valve", response_time: 20ms }
device cyl_lift: cylinder { purpose: "Lifts part for operator inspection", stroke_time: 300ms, retract_time: 300ms }
device sensor_lift_ext: sensor { purpose: "Lift extended feedback", subtype: "limit_switch" }
device sensor_lift_ret: sensor { purpose: "Lift retracted feedback", subtype: "limit_switch" }

relation { from: start_button.out, to: plc_main.X3, via: reports_to }
relation { from: confirm_button.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: valve_lift.coil, via: driven_by }
relation { from: valve_lift.out, to: cyl_lift.cmd, via: driven_by }
relation { from: cyl_lift.extended, to: sensor_lift_ext.sense, via: detects }
relation { from: sensor_lift_ext.out, to: plc_main.X0, via: reports_to }
relation { from: cyl_lift.retracted, to: sensor_lift_ret.sense, via: detects }
relation { from: sensor_lift_ret.out, to: plc_main.X1, via: reports_to }

[constraints]

causality: Y0 -> valve_lift -> cyl_lift -> sensor_lift_ext

[tasks]

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle

task cycle:
    step lift_up:
        action: extend cyl_lift
        timeout: 1200ms -> goto fault_handler.alarm
    step wait_operator_confirm:
        wait: confirm_button == true
        allow_indefinite_wait: true
    step lift_down:
        action: retract cyl_lift
        timeout: 1200ms -> goto fault_handler.alarm
    on_complete: goto ready

task fault_handler:
    step safe_outputs:
        action: set valve_lift.coil off
    step alarm:
        action: log "fault: lift action timeout"
    on_complete: goto ready
