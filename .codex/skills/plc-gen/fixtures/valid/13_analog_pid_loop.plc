# ============================================================
# 模拟量 PID 闭环控制：压力 PID + analog I/O
# ============================================================

[topology]

device AI0: analog_input {
    purpose: "压力变送器反馈，量程 0-100 bar",
    range: 0..100,
    unit: "bar",
    external: true
}

device AO0: analog_output {
    purpose: "调节阀开度指令，0-100% 对应全关到全开",
    range: 0..100,
    unit: "%"
}

device loop_pressure: pid {
    purpose: "压力闭环 PID 控制器，目标设定值 60 bar",
    pv: AI0,
    sp: 60bar,
    kp: 2.0,
    ki: 0.5,
    kd: 0.0,
    out: AO0,
    period_ms: 100,
    limit: 0..100
}

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [AI0:analog:consumer, AO0:analog:producer]
}

[constraints]

[tasks]

task main:
    step hold:
