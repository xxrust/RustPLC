[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, AI0:analog:consumer]
}

device AI0: analog_input {
    purpose: "液压站压力传感器反馈，量程 0-100 bar",
    range: 0..100,
    unit: "bar",
    external: true
}

device valve_main: solenoid_valve {
    purpose: "控制液压站主回路通断的电磁阀",
    response_time: 30ms
}

relation { from: plc_main.Y0, to: valve_main.coil, via: driven_by }

[constraints]

safety: AI0 > 90 conflicts_with AI0 < 10
    reason: "压力值不应同时处于高压与低压区间"

[tasks]

task main:
    step open_valve:
        action: set valve_main on

    step wait_pressure:
        wait: AI0 >= 60
        timeout: 5000ms -> goto fault

    step stop:
        action: set valve_main off
    on_complete: goto idle

task fault:
    step shutdown:
        action: set valve_main off
    on_complete: goto idle

task idle:
    step wait_start:
        wait: Y0 == false
        allow_indefinite_wait: true
    on_complete: goto main
