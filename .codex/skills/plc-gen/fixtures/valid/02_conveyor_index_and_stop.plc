[topology]

device Y0: digital_output
device Y1: digital_output
device X0: digital_input
device X1: digital_input
device X2: digital_input

device start_button: sensor {
    debounce: 20ms
}

device motor_conveyor: motor {
    rated_speed: 30rpm
    ramp_time: 50ms
}

device sensor_index: sensor

device valve_stopper: solenoid_valve {
    response_time: 20ms
}

device cyl_stopper: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device sensor_stop_ext: sensor

relation { from: start_button.out, to: X2, via: reports_to }
relation { from: Y0, to: motor_conveyor.cmd, via: driven_by }
relation { from: sensor_index.out, to: X0, via: reports_to }
relation { from: motor_conveyor.position_index, to: sensor_index.sense, via: detects }
relation { from: Y1, to: valve_stopper.coil, via: driven_by }
relation { from: valve_stopper.out, to: cyl_stopper.cmd, via: driven_by }
relation { from: sensor_stop_ext.out, to: X1, via: reports_to }
relation { from: cyl_stopper.extended, to: sensor_stop_ext.sense, via: detects }

[constraints]

safety: cyl_stopper.extended conflicts_with motor_conveyor.on
    reason: "挡停缸伸出时禁止传送带运行"

causality: Y0 -> motor_conveyor -> sensor_index
causality: Y1 -> valve_stopper -> cyl_stopper -> sensor_stop_ext

[tasks]

task cycle:
    step start_conveyor:
        action: set motor_conveyor on
    step wait_index:
        wait: sensor_index == true
        timeout: 5000ms -> goto fault_handler
    step stop_conveyor:
        action: set motor_conveyor off
    step settle:
        delay: 200ms
    step extend_stopper:
        action: extend cyl_stopper
        wait: sensor_stop_ext == true
        timeout: 1200ms -> goto fault_handler
    step release_stopper:
        action: retract cyl_stopper
    on_complete: goto ready

task fault_handler:
    step safe:
        action: set motor_conveyor off
        action: retract cyl_stopper
    step alarm:
        action: log "fault: conveyor/index timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle

