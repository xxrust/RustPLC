[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, Y1:digital:producer, X0:digital:consumer, X1:digital:consumer, X2:digital:consumer]
}

device start_button: sensor {
    purpose: "操作员启动按钮，触发传送带分度流程",
    subtype: "push_button",
    debounce: 20ms
}

device motor_conveyor: motor {
    purpose: "驱动传送带运行的电机",
    rated_speed: 30rpm,
    ramp_time: 50ms
}

device sensor_index: sensor {
    purpose: "检测传送带到达分度位置的接近开关",
    subtype: "proximity"
}

device valve_stopper: solenoid_valve {
    purpose: "驱动挡停缸伸出/缩回的气动电磁阀",
    response_time: 20ms
}

device cyl_stopper: cylinder {
    purpose: "在分度位置挡停工件的气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

device sensor_stop_ext: sensor {
    purpose: "检测挡停缸已完全伸出到位的限位开关",
    subtype: "limit_switch"
}

relation { from: start_button.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: motor_conveyor.cmd, via: driven_by }
relation { from: motor_conveyor.position_index, to: sensor_index.sense, via: detects }
relation { from: sensor_index.out, to: plc_main.X0, via: reports_to }
relation { from: plc_main.Y1, to: valve_stopper.coil, via: driven_by }
relation { from: valve_stopper.out, to: cyl_stopper.cmd, via: driven_by }
relation { from: cyl_stopper.extended, to: sensor_stop_ext.sense, via: detects }
relation { from: sensor_stop_ext.out, to: plc_main.X1, via: reports_to }

[constraints]

safety: cyl_stopper.extended conflicts_with motor_conveyor.run.on
    reason: "挡停缸伸出时禁止传送带运行"

causality: Y0 -> motor_conveyor -> sensor_index
causality: Y1 -> valve_stopper -> cyl_stopper -> sensor_stop_ext

[tasks]

task cycle:
    step start_conveyor:
        action: set motor_conveyor.run on
    step wait_index:
        wait: sensor_index == true
        timeout: 5000ms -> goto fault_handler
    step stop_conveyor:
        action: set motor_conveyor.run off
    step settle:
        delay: 200ms
    step extend_stopper:
        action: extend cyl_stopper
        wait: sensor_stop_ext == true
        timeout: 1200ms -> goto fault_handler
    step release_stopper:
        action: retract cyl_stopper
    on_complete: goto ready

task fault_handler:
    step safe:
        action: set motor_conveyor.run off
        action: retract cyl_stopper
    step alarm:
        action: log "fault: conveyor/index timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
