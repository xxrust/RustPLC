[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, Y1:digital:producer, X0:digital:consumer, X1:digital:consumer, X2:digital:consumer]
}

device start_button: sensor {
    purpose: "操作员启动按钮，触发分拣流程",
    subtype: "push_button",
    debounce: 20ms
}

device motor_conv: motor {
    purpose: "驱动分拣传送带运行的电机",
    rated_speed: 20rpm,
    ramp_time: 50ms
}

device sensor_A: sensor {
    purpose: "检测工件到达 A 分拣位的接近开关",
    subtype: "proximity"
}

device sensor_B: sensor {
    purpose: "检测工件到达 B 分拣位的接近开关",
    subtype: "proximity"
}

device valve_gate: solenoid_valve {
    purpose: "驱动分拣闸门气缸的电磁阀",
    response_time: 20ms
}

device cyl_gate: cylinder {
    purpose: "控制分拣闸门方向的气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

relation { from: start_button.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: motor_conv.cmd, via: driven_by }
relation { from: motor_conv.position_A, to: sensor_A.sense, via: detects }
relation { from: sensor_A.out, to: plc_main.X0, via: reports_to }
relation { from: motor_conv.position_B, to: sensor_B.sense, via: detects }
relation { from: sensor_B.out, to: plc_main.X1, via: reports_to }
relation { from: plc_main.Y1, to: valve_gate.coil, via: driven_by }
relation { from: valve_gate.out, to: cyl_gate.cmd, via: driven_by }

[constraints]

timing: task.search.detect must_complete_within 1200ms

causality: Y0 -> motor_conv -> sensor_A
causality: Y0 -> motor_conv -> sensor_B

[tasks]

task search:
    step start_conv:
        action: set motor_conv.run on
    step detect:
        race:
            branch_A:
                wait: sensor_A == true
                then: goto process_A
            branch_B:
                wait: sensor_B == true
                then: goto process_B
        timeout: 1200ms -> goto fault_handler

task process_A:
    step stop_conv:
        action: set motor_conv.run off
    step gate_to_A:
        action: retract cyl_gate
    on_complete: goto ready

task process_B:
    step stop_conv:
        action: set motor_conv.run off
    step gate_to_B:
        action: extend cyl_gate
    on_complete: goto ready

task fault_handler:
    step safe:
        action: set motor_conv.run off
        action: retract cyl_gate
    step alarm:
        action: log "fault: race timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto search
