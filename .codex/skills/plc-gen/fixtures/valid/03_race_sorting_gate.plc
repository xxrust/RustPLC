[topology]

device Y0: digital_output
device Y1: digital_output
device X0: digital_input
device X1: digital_input
device X2: digital_input

device start_button: sensor {
    debounce: 20ms
}

device motor_conv: motor {
    rated_speed: 20rpm
    ramp_time: 50ms
}

device sensor_A: sensor

device sensor_B: sensor

device valve_gate: solenoid_valve {
    response_time: 20ms
}

device cyl_gate: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

relation { from: start_button.out, to: X2.in, via: reports_to }
relation { from: Y0.out, to: motor_conv.cmd, via: driven_by }
relation { from: sensor_A.out, to: X0.in, via: reports_to }
relation { from: motor_conv.position_A, to: sensor_A.sense, via: detects }
relation { from: sensor_B.out, to: X1.in, via: reports_to }
relation { from: motor_conv.position_B, to: sensor_B.sense, via: detects }
relation { from: Y1.out, to: valve_gate.coil, via: driven_by }
relation { from: valve_gate.out, to: cyl_gate.cmd, via: driven_by }

[constraints]

timing: task.search.detect must_complete_within 1200ms

causality: Y0 -> motor_conv -> sensor_A
causality: Y0 -> motor_conv -> sensor_B

[tasks]

task search:
    step start_conv:
        action: set motor_conv on
    step detect:
        race:
            branch_A:
                wait: sensor_A == true
                then: goto process_A
            branch_B:
                wait: sensor_B == true
                then: goto process_B
        timeout: 1200ms -> goto fault_handler

task process_A:
    step stop_conv:
        action: set motor_conv off
    step gate_to_A:
        action: retract cyl_gate
    on_complete: goto ready

task process_B:
    step stop_conv:
        action: set motor_conv off
    step gate_to_B:
        action: extend cyl_gate
    on_complete: goto ready

task fault_handler:
    step safe:
        action: set motor_conv off
        action: retract cyl_gate
    step alarm:
        action: log "fault: race timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto search

