[topology]

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    ports: [Y0:digital:producer, X0:digital:consumer, X1:digital:consumer]
}

device start_button: sensor {
    purpose: "操作员启动按钮，触发单缸伸出-延时-缩回循环",
    subtype: "push_button",
    debounce: 20ms
}

device valve_act: solenoid_valve {
    purpose: "驱动执行缸伸出/缩回的气动电磁阀",
    response_time: 20ms
}

device cyl_act: cylinder {
    purpose: "演示时序约束的执行气缸",
    stroke_time: 300ms,
    retract_time: 300ms
}

device sensor_ext: sensor {
    purpose: "检测执行缸已完全伸出到位的限位开关",
    subtype: "limit_switch"
}

relation { from: start_button.out, to: plc_main.X1, via: reports_to }
relation { from: plc_main.Y0, to: valve_act.coil, via: driven_by }
relation { from: valve_act.out, to: cyl_act.cmd, via: driven_by }
relation { from: cyl_act.extended, to: sensor_ext.sense, via: detects }
relation { from: sensor_ext.out, to: plc_main.X0, via: reports_to }

[constraints]

timing: task.cycle must_complete_within 1200ms
timing: task.cycle must_complete_within_worst_case 3000ms

causality: Y0 -> valve_act -> cyl_act -> sensor_ext

[tasks]

task cycle:
    step start:
        action: extend cyl_act
        wait: sensor_ext == true
        timeout: 2000ms -> goto fault_handler
    step settle:
        delay: 200ms
    step back:
        action: retract cyl_act
    on_complete: goto ready

task fault_handler:
    step safe:
        action: retract cyl_act
    step alarm:
        action: log "fault: timing/timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
