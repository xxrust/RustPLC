[topology]

device Y0: digital_output
device Y1: digital_output
device X0: digital_input
device X1: digital_input
device X2: digital_input
device X3: digital_input
device X4: digital_input

device start_button: sensor {
    debounce: 20ms
}

device valve_hold: solenoid_valve {
    response_time: 20ms
}

device valve_work: solenoid_valve {
    response_time: 20ms
}

device cyl_hold: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device cyl_work: cylinder {
    stroke_time: 300ms
    retract_time: 300ms
}

device sensor_hold_ext: sensor

device sensor_hold_ret: sensor

device sensor_work_ext: sensor

device sensor_work_ret: sensor

relation { from: start_button.out, to: X4, via: reports_to }
relation { from: Y0, to: valve_hold.coil, via: driven_by }
relation { from: Y1, to: valve_work.coil, via: driven_by }
relation { from: valve_hold.out, to: cyl_hold.cmd, via: driven_by }
relation { from: valve_work.out, to: cyl_work.cmd, via: driven_by }
relation { from: sensor_hold_ext.out, to: X0, via: reports_to }
relation { from: cyl_hold.extended, to: sensor_hold_ext.sense, via: detects }
relation { from: sensor_hold_ret.out, to: X1, via: reports_to }
relation { from: cyl_hold.retracted, to: sensor_hold_ret.sense, via: detects }
relation { from: sensor_work_ext.out, to: X2, via: reports_to }
relation { from: cyl_work.extended, to: sensor_work_ext.sense, via: detects }
relation { from: sensor_work_ret.out, to: X3, via: reports_to }
relation { from: cyl_work.retracted, to: sensor_work_ret.sense, via: detects }

[constraints]

safety: cyl_work.extended requires cyl_hold.extended
    reason: "工艺缸动作要求夹紧保持"

safety: cyl_work.extended conflicts_with cyl_hold.retracted
    reason: "同一约束的另一种写法：工作时夹紧不能缩回"

causality: Y0 -> valve_hold -> cyl_hold -> sensor_hold_ext
causality: Y1 -> valve_work -> cyl_work -> sensor_work_ext

[tasks]

task cycle:
    step hold:
        action: extend cyl_hold
        wait: sensor_hold_ext == true
        timeout: 1200ms -> goto fault_handler
    step work:
        action: extend cyl_work
        wait: sensor_work_ext == true
        timeout: 1200ms -> goto fault_handler
    step back:
        action: retract cyl_work
        wait: sensor_work_ret == true
        timeout: 1200ms -> goto fault_handler
    step release:
        action: retract cyl_hold
        wait: sensor_hold_ret == true
        timeout: 1200ms -> goto fault_handler
    on_complete: goto ready

task fault_handler:
    step safe:
        action: retract cyl_work
        action: retract cyl_hold
    step alarm:
        action: log "fault: interlock violated or timeout"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle

