WHITESPACE = _{ " " | "\t" | NEWLINE }
NEWLINE = _{ "\r\n" | "\n" }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
integer = @{ ASCII_DIGIT+ }

string_literal = @{ "\"" ~ ("\\\"" | !"\"" ~ ANY)* ~ "\"" }
state_reference = @{ identifier ~ "." ~ identifier ~ ("." ~ identifier)? }
duration_value = @{ number ~ ("ms" | "s") }
measured_value = @{ number ~ ASCII_ALPHA+ }
boolean_value = { "true" | "false" }
identifier_list = { "[" ~ identifier ~ ("," ~ identifier)* ~ ","? ~ "]" }

section_topology = { "[" ~ "topology" ~ "]" }
section_constraints = { "[" ~ "constraints" ~ "]" }
section_tasks = { "[" ~ "tasks" ~ "]" }

device_type = {
    "digital_output"
    | "digital_input"
    | "plc"
    | "solenoid_valve"
    | "cylinder"
    | "sensor"
    | "stepper_motor"
    | "servo_drive"
    | "cam_coupling"
    | "vfd"
    | "motor"
    | "analog_output"
    | "analog_input"
    | "pid"
}

attribute_name = {
    "driven_by"
    | "reports_to"
    | "purpose"
    | "response_time"
    | "stroke_time"
    | "retract_time"
    | "stroke"
    | "subtype"
    | "type"
    | "detects"
    | "debounce"
    | "inverted"
    | "external"
    | "rated_speed"
    | "ramp_time"
    | "states"
    | "ports"
    | "tags"
    | "range"
    | "unit"
    // PID minimal loop
    | "pv"
    | "sp"
    | "kp"
    | "ki"
    | "kd"
    | "out"
    | "period_ms"
    | "limit"
    // Cam coupling params
    | "master"
    | "slave_feedback"
    | "slave"
    | "table"
    | "interpolation"
    | "gear_ratio"
    | "phase_offset"
    | "following_error_limit"
    // Motor enhancement params
    | "steps_per_rev"
    | "max_speed"
    | "accel_time"
    | "decel_time"
    | "encoder_resolution"
    | "electronic_gear_num"
    | "electronic_gear_den"
    | "positioning_window"
    | "rated_power"
    | "rated_freq"
}

range_value = @{ number ~ ".." ~ number }
port_type = { "digital" | "analog" | "pneumatic" | "logical" | "generic" }
port_role = { "producer" | "consumer" | "bidirectional" }
port_definition = { identifier ~ ":" ~ port_type ~ ":" ~ port_role }
port_list = { "[" ~ port_definition ~ ("," ~ port_definition)* ~ ","? ~ "]" }
tag_dimension_name = { "functional_group" | "danger_level" | "location_group" }
tag_value = { identifier | string_literal }
tag_value_list = { "[" ~ tag_value ~ ("," ~ tag_value)* ~ ","? ~ "]" }
tag_dimension = { tag_dimension_name ~ ":" ~ tag_value_list }
tags_value = { "{" ~ tag_dimension ~ ((","? ~ tag_dimension))* ~ ","? ~ "}" }

attribute_value = {
    state_reference
    | duration_value
    | range_value
    | measured_value
    | number
    | integer
    | string_literal
    | boolean_value
    | port_list
    | tags_value
    | identifier_list
    | identifier
}

attribute = { attribute_name ~ ":" ~ attribute_value }
attribute_block = { "{" ~ attribute ~ ((","? ~ attribute))* ~ ","? ~ "}" }

device_declaration = { "device" ~ identifier ~ ":" ~ device_type ~ attribute_block? }
variable_type = { "float" | "int" | "bool" }
variable_initializer = { number | integer | boolean_value }
variable_declaration = {
    "variable" ~ identifier ~ ":" ~ variable_type ~ "=" ~ variable_initializer
}
cam_table_mode = { "periodic" | "oneshot" }
cam_point = { "(" ~ number ~ "," ~ number ~ ")" }
cam_point_list = { "[" ~ cam_point ~ ("," ~ cam_point)* ~ ","? ~ "]" }
cam_table_declaration = {
    "cam_table" ~ identifier ~ ":" ~ cam_table_mode ~ cam_point_list
}

port_reference = @{ identifier ~ "." ~ identifier }
endpoint_reference = _{ port_reference | identifier }
topology_relation = { "driven_by" | "reports_to" | "detects" }
relation_field_name = { "from" | "to" | "via" }
relation_field_value = { topology_relation | endpoint_reference }
relation_field = { relation_field_name ~ ":" ~ relation_field_value }
relation_declaration = { "relation" ~ "{" ~ relation_field ~ ((","? ~ relation_field))* ~ ","? ~ "}" }
topology_entry = _{
    device_declaration
    | relation_declaration
    | variable_declaration
    | cam_table_declaration
}

topology_section = { section_topology ~ topology_entry* }
topology_file = { SOI ~ topology_section ~ EOI }

safety_relation = { "conflicts_with" | "requires" }
analog_condition = { (state_reference | identifier) ~ comparison_operator ~ (measured_value | number) }
safety_operand = { analog_condition | state_reference }
safety_constraint = {
    "safety" ~ ":" ~ safety_operand ~ safety_relation ~ safety_operand ~ reason_clause?
}

timing_scope = { "task" ~ "." ~ identifier ~ ("." ~ identifier)? }
// Order matters: `must_complete_within` is a prefix of `must_complete_within_worst_case`.
timing_relation = { "must_complete_within_worst_case" | "must_complete_within" | "must_start_after" }
timing_constraint = {
    "timing" ~ ":" ~ timing_scope ~ timing_relation ~ duration_value ~ reason_clause?
}

causality_chain = { identifier ~ ("->" ~ identifier)+ }
causality_constraint = { "causality" ~ ":" ~ causality_chain ~ reason_clause? }

reason_clause = { "reason" ~ ":" ~ string_literal }

constraint_declaration = {
    safety_constraint
    | timing_constraint
    | causality_constraint
}

constraints_section = { section_constraints ~ constraint_declaration* }
constraints_file = { SOI ~ constraints_section ~ EOI }

action_target    = @{ identifier ~ ("." ~ identifier)? }
action_extend    = { "extend" ~ action_target }
action_retract   = { "retract" ~ action_target }
binary_output_value = { "on" | "off" }
state_value      = @{ identifier }
expr_literal = @{ number | integer }
expr_variable = @{ identifier }
expr_func_call = { identifier ~ "(" ~ expression ~ ("," ~ expression)* ~ ")" }
expr_atom = { expr_func_call | expr_literal | expr_variable | "(" ~ expression ~ ")" }
expr_unary = { "-" ~ expr_unary | expr_atom }
expr_mul_op = { "*" | "/" | "%" }
expr_mul = { expr_unary ~ (expr_mul_op ~ expr_unary)* }
expr_add_op = { "+" | "-" }
expression = { expr_mul ~ (expr_add_op ~ expr_mul)* }
action_set_analog = { "set_analog" ~ action_target ~ number }
action_set_analog_expr = { "set_analog" ~ action_target ~ expression }
compute_statement = { "compute" ~ identifier ~ "=" ~ expression }
action_cam_engage = { "cam_engage" ~ identifier }
action_cam_disengage = { "cam_disengage" ~ identifier }
action_cam_switch = { "cam_switch" ~ identifier ~ identifier }
action_cam_phase = { "cam_phase" ~ identifier ~ expression }
action_set       = { "set" ~ action_target ~ state_value }
action_log = { "log" ~ string_literal }
action_command = {
    action_extend
    | action_retract
    | action_cam_disengage
    | action_cam_engage
    | action_cam_switch
    | action_cam_phase
    | action_set_analog
    | action_set_analog_expr
    | compute_statement
    | action_set
    | action_log
}

condition_operand = { state_reference | identifier }
comparison_operator = { ">=" | "<=" | "==" | "!=" | ">" | "<" }
condition_value = {
    boolean_value
    | measured_value
    | number
    | string_literal
    | state_reference
    | identifier
}

action_statement = { "action" ~ ":" ~ action_command }
condition_expr = { expression ~ comparison_operator ~ expression }
simple_condition = { condition_operand ~ comparison_operator ~ condition_value | condition_expr }
logical_operator = { "AND" | "OR" }
wait_condition = { simple_condition ~ (logical_operator ~ simple_condition)* }
wait_statement = { "wait" ~ ":" ~ wait_condition }
delay_statement = { "delay" ~ ":" ~ duration_value }
goto_target = { identifier ~ ("." ~ identifier)? }
goto_statement = { "goto" ~ goto_target }
timeout_statement = { "timeout" ~ ":" ~ duration_value ~ "->" ~ goto_statement }
allow_indefinite_wait_statement = { "allow_indefinite_wait" ~ ":" ~ boolean_value }
then_goto_statement = { "then" ~ ":" ~ goto_statement }

repeat_block = { "repeat" ~ integer ~ ":" ~ step_statement+ }

if_else_statement = { "if" ~ ":" ~ simple_condition ~ goto_statement ~ "else" ~ ":" ~ goto_statement }

parallel_branch_statement = {
    action_statement
    | wait_statement
    | delay_statement
    | timeout_statement
    | allow_indefinite_wait_statement
    | goto_statement
    | if_else_statement
    | repeat_block
}
parallel_branch = { identifier ~ ":" ~ parallel_branch_statement+ }
parallel_statement = { "parallel" ~ ":" ~ parallel_branch+ }

race_branch_statement = {
    action_statement
    | wait_statement
    | delay_statement
    | timeout_statement
    | allow_indefinite_wait_statement
    | goto_statement
    | if_else_statement
    | repeat_block
}
race_branch = { identifier ~ ":" ~ race_branch_statement+ ~ then_goto_statement }
race_statement = { "race" ~ ":" ~ race_branch+ }

step_statement = {
    action_statement
    | wait_statement
    | delay_statement
    | timeout_statement
    | goto_statement
    | if_else_statement
    | parallel_statement
    | race_statement
    | allow_indefinite_wait_statement
    | repeat_block
}
step_declaration = { "step" ~ identifier ~ ":" ~ step_statement* }

on_complete_statement = { "on_complete" ~ ":" ~ (goto_statement | "unreachable") }
task_declaration = { "task" ~ identifier ~ ":" ~ step_declaration* ~ on_complete_statement? }

tasks_section = { section_tasks ~ task_declaration* }
tasks_file = { SOI ~ tasks_section ~ EOI }

plc_file = { SOI ~ topology_section ~ constraints_section ~ tasks_section ~ EOI }
