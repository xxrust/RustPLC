[topology]


device valve_A: solenoid_valve {
    purpose: "驱动 A 缸的电磁阀（故意与 valve_B 产生冲突，用于触发 safety 验证失败）",
    response_time: 20ms
}

device valve_B: solenoid_valve {
    purpose: "驱动 B 缸的电磁阀（故意与 valve_A 产生冲突，用于触发 safety 验证失败）",
    response_time: 20ms
}

device cyl_A: cylinder {
    purpose: "与 cyl_B 存在互斥约束的气缸，用于触发 safety 冲突验证",
    stroke_time: 200ms
    retract_time: 200ms
}

device cyl_B: cylinder {
    purpose: "与 cyl_A 存在互斥约束的气缸，用于触发 safety 冲突验证",
    stroke_time: 200ms
    retract_time: 200ms
}

device sensor_A_ext: sensor {
    purpose: "检测 A 缸伸出到位的传感器，因果链故意断开以触发 causality 验证失败",
    type: magnetic
}

device sensor_B_ext: sensor {
    purpose: "检测 B 缸伸出到位的传感器，因果链故意断开以触发 causality 验证失败",
    type: magnetic
}

relation { from: plc_main.Y0, to: valve_A.coil, via: driven_by }
relation { from: valve_A.out, to: cyl_A.cmd, via: driven_by }
relation { from: plc_main.Y1, to: valve_B.coil, via: driven_by }
relation { from: valve_B.out, to: cyl_B.cmd, via: driven_by }
relation { from: cyl_A.extended, to: sensor_A_ext.sense, via: detects }
relation { from: sensor_A_ext.out, to: plc_main.X0, via: reports_to }
relation { from: cyl_B.extended, to: sensor_B_ext.sense, via: detects }
relation { from: sensor_B_ext.out, to: plc_main.X1, via: reports_to }

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [Y0:digital:producer, Y1:digital:producer, X0:digital:consumer, X1:digital:consumer] }
[constraints]

safety: cyl_A.extended conflicts_with cyl_B.extended

timing: task.main must_complete_within 50ms

causality: Y0 -> valve_A -> cyl_B -> sensor_B_ext

[tasks]

task main:
    step trigger:
        parallel:
            branch_A:
                action: extend cyl_A
            branch_B:
                action: extend cyl_B
        wait: sensor_B_ext == true
