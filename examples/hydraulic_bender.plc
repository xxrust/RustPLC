# ============================================================
# 液压折弯机控制系统
# 压力闭环 + 行程控制，PID 保压，超压保护
# ============================================================

[topology]

# ===== 控制器 =====
device plc_main: plc {
    purpose: "液压折弯机 PLC 控制器，管理液压缸行程与压力闭环 I/O 端口",
    ports: [Y0:digital:producer, X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, AI0:analog:consumer, AO0:analog:producer]
}

# ===== 模拟量 I/O =====
device AI0: analog_input {
    purpose: "液压系统压力变送器反馈，量程 0-100 bar，用于 PID 闭环和超压保护",
    range: 0..100,
    unit: "bar",
    external: true
}

device AO0: analog_output {
    purpose: "液压比例阀开度指令输出，0-100% 对应全关到全开，控制液压缸速度和压力",
    range: 0..100,
    unit: "%"
}

# ===== PID 控制器 =====
device pid_pressure: pid {
    purpose: "液压压力闭环 PID 控制器，设定值 60 bar，输出驱动比例阀开度",
    pv: AI0,
    sp: 60bar,
    kp: 2.0,
    ki: 0.5,
    kd: 0.1,
    out: AO0,
    period_ms: 100,
    limit: 0..100
}

# ===== 液压缸方向阀 =====
device valve_hyd: solenoid_valve {
    purpose: "液压缸方向控制电磁阀，控制液压缸伸出（下行）和缩回（回程）方向",
    response_time: 30ms
}

device cyl_hyd: cylinder {
    purpose: "液压折弯缸，快速下行接触工件后切换慢速加压，折弯完成后快速回程",
    stroke_time: 1500ms,
    retract_time: 1500ms
}

# ===== 行程传感器 =====
device sensor_hyd_contact: sensor {
    purpose: "检测液压缸已下行到工件接触位置的接近开关，触发后切换慢速加压模式",
    subtype: "proximity_sensor",
    debounce: 20ms
}

device sensor_hyd_ret: sensor {
    purpose: "检测液压缸已完全缩回到原位的限位开关，确认回程完成",
    subtype: "limit_switch",
    debounce: 20ms
}

# ===== 启动按钮 =====
device start_button: sensor {
    purpose: "操作员启动按钮，放置工件后按下触发一次折弯循环",
    subtype: "push_button",
    debounce: 20ms
}

# ===== 拓扑关系 =====
relation { from: start_button.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: valve_hyd.coil, via: driven_by }
relation { from: valve_hyd.out, to: cyl_hyd.cmd, via: driven_by }
relation { from: cyl_hyd.extended, to: sensor_hyd_contact.sense, via: detects }
relation { from: sensor_hyd_contact.out, to: plc_main.X0, via: reports_to }
relation { from: cyl_hyd.retracted, to: sensor_hyd_ret.sense, via: detects }
relation { from: sensor_hyd_ret.out, to: plc_main.X1, via: reports_to }

[constraints]

# ===== 超压安全约束 =====
safety: AI0 > 90 conflicts_with AI0 < 10
    reason: "压力超过 90 bar 时禁止继续加压，防止液压管路破裂和人身伤害"

# ===== 时序约束 =====
timing: task.cycle must_complete_within_worst_case 15000ms
    reason: "折弯循环含所有超时上界不得超过 15 秒"

# ===== 因果链 =====
causality: Y0 -> valve_hyd -> cyl_hyd -> sensor_hyd_contact
    reason: "液压缸下行应能被接触位传感器检测"

causality: Y0 -> valve_hyd -> cyl_hyd -> sensor_hyd_ret
    reason: "液压缸回程应能被原位传感器检测"

[tasks]

task cycle:
    # 快速下行：先设置比例阀大开度，再开方向阀驱动液压缸下行
    step set_fast_speed:
        action: set_analog AO0 80
        action: log "设置快速下行开度 80%"

    step fast_down:
        action: set valve_hyd on
        wait: sensor_hyd_contact == true
        timeout: 3000ms -> goto fault_handler

    # 切换慢速加压：减小比例阀开度，等待压力达到设定值
    step set_slow_speed:
        action: set_analog AO0 30
        action: log "切换慢速加压开度 30%，PID 闭环启动"

    step wait_pressure:
        action: log "等待压力升至 58 bar"
        wait: AI0 >= 58
        timeout: 5000ms -> goto fault_handler

    # 保压 2000ms
    step hold_pressure:
        action: log "压力达标，保压 2000ms"
        delay: 2000ms

    # 快速回程：关闭比例阀，关闭方向阀，液压缸缩回
    step close_valve:
        action: set_analog AO0 0
        action: log "关闭比例阀"

    step fast_return:
        action: set valve_hyd off
        wait: sensor_hyd_ret == true
        timeout: 3000ms -> goto fault_handler

    on_complete: goto ready

task fault_handler:
    step safe_stop:
        action: set_analog AO0 0
        action: set valve_hyd off
    step alarm:
        action: log "液压折弯机故障：超时或超压，已关闭液压阀，请人工检查"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
