# ============================================================
# 液压站比例阀压力控制示例
# 演示 analog_input / analog_output / set_analog / 阈值比较 + external 输入标记
# ============================================================

[topology]

# ===== 控制器端口 =====

# ===== 模拟量 I/O =====
device AI0: analog_input  { purpose: "液压站压力传感器反馈，量程 0-100 bar",  range: 0..100, unit: "bar", external: true }
device AO0: analog_output { purpose: "比例阀开度指令输出，0-10V 对应 0-100% 开度",  range: 0..10, ramp_time: 500ms }

# ===== 执行器与传感器 =====
device prop_valve: solenoid_valve {
    purpose: "液压站比例电磁阀，控制系统压力大小",
    response_time: 30ms
}

device pressure_sensor: sensor { purpose: "检测液压站当前压力是否达到目标值的压力传感器" }

device start_button: sensor {
    purpose: "操作员启动按钮，触发液压升压流程",
    debounce: 20ms
}

relation { from: plc_main.Y0, to: prop_valve.coil, via: driven_by }
relation { from: prop_valve.on, to: pressure_sensor.sense, via: detects }
relation { from: pressure_sensor.out, to: plc_main.AI0, via: reports_to }
relation { from: start_button.out, to: plc_main.X0, via: reports_to }

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [Y0:digital:producer, X0:digital:consumer, AI0:analog:consumer, AO0:analog:producer] }
[constraints]

# ===== 时序约束 =====
timing: task.main must_complete_within 10000ms
    reason: "主流程不应超过 10 秒"

# ===== 因果链 =====
causality: Y0 -> prop_valve -> pressure_sensor
    reason: "数字输出驱动比例阀，压力传感器检测反馈"

[tasks]

task main:
    step set_output:
        action: set_analog AO0 7.5
        action: log "设置模拟输出 7.5V"

    step open_valve:
        action: set prop_valve on
        wait: AI0 > 80
        timeout: 5000ms -> goto fault

    step hold_pressure:
        action: log "压力已达标，保持运行"
        delay: 2000ms

    step shutdown:
        action: set_analog AO0 0
        action: set prop_valve off
        action: log "系统关闭"

    on_complete: goto ready

task fault:
    step emergency_stop:
        action: set_analog AO0 0
        action: set prop_valve off
    step alarm:
        action: log "压力升压超时，请检查比例阀和压力传感器"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto main
