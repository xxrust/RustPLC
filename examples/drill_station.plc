[topology]

device Y0: digital_output
device Y1: digital_output
device Y2: digital_output
device Y3: digital_output
device X0: digital_input
device X1: digital_input
device X2: digital_input
device X3: digital_input
device X4: digital_input
device X5: digital_input

device start_button: digital_input {
    connected_to: X5
    debounce: 20ms
}

device motor_conveyor: motor {
    connected_to: Y0
    rated_speed: 30rpm
    ramp_time: 50ms
}

device sensor_arrive: sensor {
    connected_to: X0
    detects: motor_conveyor.position_A
}

device valve_clamp: solenoid_valve {
    connected_to: Y1
    response_time: 20ms
}

device cyl_clamp: cylinder {
    connected_to: valve_clamp
    stroke_time: 300ms
    retract_time: 300ms
}

device sensor_clamp_ext: sensor {
    connected_to: X1
    detects: cyl_clamp.extended
}

device sensor_clamp_ret: sensor {
    connected_to: X2
    detects: cyl_clamp.retracted
}

device motor_drill: motor {
    connected_to: Y2
    rated_speed: 3000rpm
    ramp_time: 50ms
}

device valve_feed: solenoid_valve {
    connected_to: Y3
    response_time: 20ms
}

device cyl_feed: cylinder {
    connected_to: valve_feed
    stroke_time: 300ms
    retract_time: 300ms
}

device sensor_feed_ext: sensor {
    connected_to: X3
    detects: cyl_feed.extended
}

device sensor_feed_ret: sensor {
    connected_to: X4
    detects: cyl_feed.retracted
}

[constraints]

safety: cyl_feed.extended requires cyl_clamp.extended
    reason: "钻孔时工件必须被夹紧，否则工件飞出"

causality: Y0 -> motor_conveyor -> sensor_arrive
    reason: "传送带运转应能被到位传感器检测"

causality: Y1 -> valve_clamp -> cyl_clamp -> sensor_clamp_ext
    reason: "夹紧缸伸出应能被传感器检测"

causality: Y3 -> valve_feed -> cyl_feed -> sensor_feed_ext
    reason: "进给缸伸出应能被传感器检测"

[tasks]

task cycle:
    step start_conveyor:
        action: set motor_conveyor on
    step wait_arrive:
        wait: sensor_arrive == true
        timeout: 5000ms -> goto fault_handler
    step stop_conveyor:
        action: set motor_conveyor off
    step clamp:
        action: extend cyl_clamp
        wait: sensor_clamp_ext == true
        timeout: 500ms -> goto fault_handler
    step start_drill:
        action: set motor_drill on
    step feed_down:
        action: extend cyl_feed
        wait: sensor_feed_ext == true
        timeout: 500ms -> goto fault_handler
    step feed_up:
        action: retract cyl_feed
        wait: sensor_feed_ret == true
        timeout: 500ms -> goto fault_handler
    step stop_drill:
        action: set motor_drill off
    step unclamp:
        action: retract cyl_clamp
        wait: sensor_clamp_ret == true
        timeout: 500ms -> goto fault_handler
    step send_away:
        action: set motor_conveyor on
    step wait_leave:
        wait: sensor_arrive == false
        timeout: 3000ms -> goto fault_handler
    step stop_conveyor_final:
        action: set motor_conveyor off
    on_complete: goto ready

task fault_handler:
    step safe_retract:
        action: retract cyl_feed
        action: retract cyl_clamp
    step safe_stop:
        action: set motor_drill off
        action: set motor_conveyor off
    step alarm:
        action: log "自动钻孔工位故障：动作超时"
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
