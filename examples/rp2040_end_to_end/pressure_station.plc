[topology]
device AI0: analog_input  { purpose: "AI0: 模拟量输入采集点",  range: 0..100, unit: "bar", external: true }
device AO0: analog_output { purpose: "AO0: 模拟量输出控制点",  range: 0..10, unit: "V", ramp_time: 500ms }


device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [AI0:analog:consumer, AO0:analog:producer] }
[constraints]

[tasks]

task main:
    step set_output:
        action: set_analog AO0 7.5
        action: log "set output to 7.5V"

    step wait_pressure:
        wait: AI0 > 80
        timeout: 5000ms -> goto fault

    step shutdown:
        action: set_analog AO0 0
        action: log "pressure reached, output reset"

    on_complete: goto main

task fault:
    step stop:
        action: set_analog AO0 0
    step alarm:
        action: log "pressure timeout"
    on_complete: goto main
