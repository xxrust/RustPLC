[topology]

# Minimal, runnable example showing:
# - external zone_code (0=safe, 1..N=danger window)
# - a mutual-exclusion safety rule (zone_code vs actuator state)
# - a timeout -> goto fault path

# Physical IO
device Y0: digital_output  # DIR
device Y1: digital_output  # EN
device Y2: digital_output  # clamp valve
device Y3: digital_output  # MOVE_CMD
device X0: digital_input   # INPOS
device X1: digital_input   # ALARM
device X2: digital_input   # clamp extended
device X3: digital_input   # clamp retracted
device X4: digital_input   # encoder dir sign (+)
device AI0: analog_input { range: 0..4000000, unit: "count", external: true } # axis count snapshot
device AI1: analog_input { range: 0..3, unit: "zone", external: true }        # 0=safe, 1..N=danger

# External feedback provided by the drive / board layer (logical aliases for scenarios/tests).
device axis_count: analog_input { connected_to: AI0, range: 0..4000000, unit: "count" }
device zone_code: analog_input { connected_to: AI1, range: 0..3, unit: "zone" } # 0=safe, 1..N=danger

# Logical devices
device axis_x: motor {
    connected_to: Y1
    ramp_time: 10ms
}

device dir_positive: digital_output {
    connected_to: Y0
}

device move_cmd: digital_output {
    connected_to: Y3
}

device clamp_valve: solenoid_valve {
    connected_to: Y2
    response_time: 20ms
}

device cyl_clamp: cylinder {
    connected_to: clamp_valve
    stroke_time: 200ms
    retract_time: 200ms
}

device inpos_x: sensor {
    connected_to: X0
    detects: axis_x.position_ok
}

device alarm_x: sensor {
    connected_to: X1
    detects: axis_x.alarm
}

device enc_dir_positive: digital_input {
    connected_to: X4
}

device clamp_ext: sensor {
    connected_to: X2
    detects: cyl_clamp.extended
}

device clamp_ret: sensor {
    connected_to: X3
    detects: cyl_clamp.retracted
}

[constraints]

# Basic: do not enable the axis while drive is alarming.
safety: axis_x.on requires alarm_x.off
    reason: "Drive alarm must be cleared before enabling axis"

# Collision guard: when we're in any danger window, the clamp must NOT be extended.
safety: zone_code > 0 conflicts_with cyl_clamp.extended
    reason: "zone_code indicates a collision window; clamp must stay retracted"

# Bi-directional command interlock: while issuing motion commands, the clamp must be in a safe pose.
safety: move_cmd.on conflicts_with cyl_clamp.extended
    reason: "Motion command requires clamp retracted to avoid collision"

[tasks]

task cycle:
    # Fault scenario hook: alarm input can be driven by scenarios to exercise the fault path.
    step wait_alarm_clear:
        wait: alarm_x == false
        timeout: 200ms -> goto fault

    step enable_axis:
        action: set axis_x on

    step set_dir_positive:
        action: set dir_positive on

    # Wait for safe window before allowing motion progress.
    step wait_safe_zone:
        wait: zone_code == 0
        timeout: 1000ms -> goto fault

    step start_move:
        action: set move_cmd on

    # Fault scenario hook: if encoder direction feedback disagrees with the commanded direction,
    # we should fail fast instead of waiting forever for a target count that will never arrive.
    step wait_dir_feedback:
        wait: enc_dir_positive == true
        timeout: 500ms -> goto fault

    # In a real system, motion happens in the drive; PLC just waits on feedback.
    step wait_target_count:
        wait: axis_count >= 120000
        timeout: 3000ms -> goto fault

    step wait_inpos:
        wait: inpos_x == true
        timeout: 1000ms -> goto fault

    step stop_move:
        action: set move_cmd off

    on_complete: goto idle

task fault:
    step safe:
        action: set axis_x off
        action: retract cyl_clamp
    step log:
        action: log "fault: timeout waiting for safe window / motion feedback"
    on_complete: goto idle

task idle:
    step hold:
        allow_indefinite_wait: true
