[topology]

# Minimal, runnable example showing:
# - external zone_code (0=safe, 1..N=danger window)
# - a mutual-exclusion safety rule (zone_code vs actuator state)
# - a timeout -> goto fault path
# - normalized analog inputs on AI0/AI1 (0..1 board-scale values)

device axis_count_probe: sensor {
    purpose: "normalized axis progress snapshot source for AI0"
    ports: [out:analog:producer]
}

device collision_zone_probe: sensor {
    purpose: "normalized collision window code source for AI1"
    ports: [out:analog:producer]
}

device plc_main: plc {
    purpose: "controller with mapped IO"
    model_ref: openplc_softplc
}

device axis_x: motor {
    purpose: "X axis drive"
    ramp_time: 10ms
}

device clamp_valve: solenoid_valve {
    purpose: "clamp valve"
    response_time: 20ms
}

device cyl_clamp: cylinder {
    purpose: "clamp cylinder"
    stroke_time: 200ms
    retract_time: 200ms
}

device inpos_x: sensor { purpose: "axis in-position feedback" }
device alarm_x: sensor { purpose: "axis alarm feedback" }
device clamp_ext: sensor { purpose: "clamp extended limit" }
device clamp_ret: sensor { purpose: "clamp retracted limit" }

relation { from: axis_count_probe.out, to: plc_main.AI0, via: reports_to }
relation { from: collision_zone_probe.out, to: plc_main.AI1, via: reports_to }
relation { from: plc_main.Y1, to: axis_x.cmd, via: driven_by }
relation { from: plc_main.Y2, to: clamp_valve.coil, via: driven_by }
relation { from: clamp_valve.out, to: cyl_clamp.cmd, via: driven_by }
relation { from: axis_x.position_ok, to: inpos_x.sense, via: detects }
relation { from: inpos_x.out, to: plc_main.X0, via: reports_to }
relation { from: axis_x.alarm, to: alarm_x.sense, via: detects }
relation { from: alarm_x.out, to: plc_main.X1, via: reports_to }
relation { from: cyl_clamp.extended, to: clamp_ext.sense, via: detects }
relation { from: clamp_ext.out, to: plc_main.X2, via: reports_to }
relation { from: cyl_clamp.retracted, to: clamp_ret.sense, via: detects }
relation { from: clamp_ret.out, to: plc_main.X3, via: reports_to }

[constraints]

safety: axis_x.run.on requires alarm_x.off
    reason: "Drive alarm must be cleared before enabling axis"

safety: AI1 > 0 conflicts_with cyl_clamp.extended
    reason: "zone_code indicates a collision window; clamp must stay retracted"

safety: Y3.on conflicts_with cyl_clamp.extended
    reason: "Motion command requires clamp retracted to avoid collision"

[tasks]

task cycle:
    step wait_alarm_clear:
        wait: alarm_x == false
        timeout: 200ms -> goto fault

    step enable_axis:
        action: set axis_x.run on

    step set_dir_positive:
        action: set Y0 on

    step wait_safe_zone:
        wait: AI1 == 0
        timeout: 1000ms -> goto fault

    step start_move:
        action: set Y3 on

    step wait_dir_feedback:
        wait: X4 == true
        timeout: 500ms -> goto fault

    step wait_target_count:
        wait: AI0 >= 0.8
        timeout: 3000ms -> goto fault

    step wait_inpos:
        wait: inpos_x == true
        timeout: 1000ms -> goto fault

    step stop_move:
        action: set Y3 off

    on_complete: goto idle

task fault:
    step safe:
        action: set axis_x.run off
        action: retract cyl_clamp
    step log:
        action: log "fault: timeout waiting for safe window / motion feedback"
    on_complete: goto idle

task idle:
    step hold:
        allow_indefinite_wait: true
