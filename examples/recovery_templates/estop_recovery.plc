[topology]


device start_button: sensor {
    purpose: "操作员启动按钮，急停解除后重新启动传送带流程",
    subtype: "push_button"
    debounce: 20ms
}
device estop_button: sensor {
    purpose: "急停按钮，按下时立即停止传送带并触发恢复流程",
    subtype: "e_stop_button"
    inverted: true
    debounce: 20ms
}
device part_sensor: sensor {
    purpose: "工件到位检测传感器，确认工件已输送到目标工位",
    subtype: "proximity_sensor"
}
device conveyor: motor { purpose: "传送带驱动电机，急停触发时立即停止" }
device alarm_light: solenoid_valve { purpose: "报警指示灯，急停期间持续点亮直到操作员确认解除" }

relation { from: start_button.out, to: plc_main.X0, via: reports_to }
relation { from: estop_button.out, to: plc_main.X1, via: reports_to }
relation { from: part_sensor.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: conveyor.cmd, via: driven_by }
relation { from: plc_main.Y1, to: alarm_light.coil, via: driven_by }

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, Y0:digital:producer, Y1:digital:producer] }
[constraints]

[tasks]

task cycle:
    step precheck_estop:
        wait: estop_button == false
        timeout: 50ms -> goto estop_recovery
    step start_conveyor:
        action: set conveyor on
    step wait_part_arrival:
        wait: part_sensor == true
        timeout: 1500ms -> goto estop_recovery
    step stop_conveyor:
        action: set conveyor off
    on_complete: goto ready

task estop_recovery:
    step safe_stop:
        action: set conveyor off
        action: set alarm_light on
    step wait_estop_release:
        wait: estop_button == false
        timeout: 10000ms -> goto estop_recovery
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
