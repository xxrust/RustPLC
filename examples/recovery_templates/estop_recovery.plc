[topology]

device X0: digital_input
device X1: digital_input
device X2: digital_input
device Y0: digital_output
device Y1: digital_output

device start_button: sensor {
    subtype: "push_button"
    debounce: 20ms
}
device estop_button: sensor {
    subtype: "e_stop_button"
    inverted: true
    debounce: 20ms
}
device part_sensor: sensor {
    subtype: "proximity_sensor"
}
device conveyor: motor
device alarm_light: solenoid_valve

relation { from: start_button.out, to: X0, via: reports_to }
relation { from: estop_button.out, to: X1, via: reports_to }
relation { from: part_sensor.out, to: X2, via: reports_to }
relation { from: Y0, to: conveyor.cmd, via: driven_by }
relation { from: Y1, to: alarm_light.coil, via: driven_by }

[constraints]

[tasks]

task cycle:
    step precheck_estop:
        wait: estop_button == false
        timeout: 50ms -> goto estop_recovery
    step start_conveyor:
        action: set conveyor on
    step wait_part_arrival:
        wait: part_sensor == true
        timeout: 1500ms -> goto estop_recovery
    step stop_conveyor:
        action: set conveyor off
    on_complete: goto ready

task estop_recovery:
    step safe_stop:
        action: set conveyor off
        action: set alarm_light on
    step wait_estop_release:
        wait: estop_button == false
        timeout: 10000ms -> goto estop_recovery
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
