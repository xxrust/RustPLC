[topology]


device start_button: sensor {
    purpose: "操作员启动按钮，触发气缸伸出/缩回循环",
    debounce: 20ms
}
device sensor_extend: sensor { purpose: "检测气缸已完全伸出到位的限位传感器，卡死时触发维护恢复流程" }
device maintenance_reset: sensor { purpose: "维护人员确认复位按钮，传感器卡死故障处理完毕后按下以恢复运行" }
device cyl_extend_cmd: solenoid_valve { purpose: "控制气缸伸出动作的电磁阀" }
device cyl_retract_cmd: solenoid_valve { purpose: "控制气缸缩回动作的电磁阀" }
device alarm_light: solenoid_valve { purpose: "报警指示灯，传感器卡死期间持续点亮等待维护人员介入" }

relation { from: start_button.out, to: plc_main.X0, via: reports_to }
relation { from: sensor_extend.out, to: plc_main.X1, via: reports_to }
relation { from: maintenance_reset.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: cyl_extend_cmd.coil, via: driven_by }
relation { from: plc_main.Y1, to: cyl_retract_cmd.coil, via: driven_by }
relation { from: plc_main.Y2, to: alarm_light.coil, via: driven_by }

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, Y0:digital:producer, Y1:digital:producer, Y2:digital:producer] }
[constraints]

[tasks]

task cycle:
    step command_extend:
        action: set cyl_retract_cmd off
        action: set cyl_extend_cmd on
    step wait_extend_feedback:
        wait: sensor_extend == true
        timeout: 800ms -> goto sensor_stuck_recovery
    step command_retract:
        action: set cyl_extend_cmd off
        action: set cyl_retract_cmd on
    step settle:
        delay: 120ms
    on_complete: goto ready

task sensor_stuck_recovery:
    step force_safe_state:
        action: set cyl_extend_cmd off
        action: set cyl_retract_cmd off
        action: set alarm_light on
    step wait_maintenance_reset:
        wait: maintenance_reset == true
        allow_indefinite_wait: true
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
