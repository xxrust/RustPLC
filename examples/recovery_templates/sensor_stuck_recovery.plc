[topology]

device X0: digital_input
device X1: digital_input
device X2: digital_input
device Y0: digital_output
device Y1: digital_output
device Y2: digital_output

device start_button: sensor {
    debounce: 20ms
}
device sensor_extend: sensor
device maintenance_reset: sensor
device cyl_extend_cmd: solenoid_valve
device cyl_retract_cmd: solenoid_valve
device alarm_light: solenoid_valve

relation { from: start_button.out, to: X0, via: reports_to }
relation { from: sensor_extend.out, to: X1, via: reports_to }
relation { from: maintenance_reset.out, to: X2, via: reports_to }
relation { from: Y0, to: cyl_extend_cmd.coil, via: driven_by }
relation { from: Y1, to: cyl_retract_cmd.coil, via: driven_by }
relation { from: Y2, to: alarm_light.coil, via: driven_by }

[constraints]

[tasks]

task cycle:
    step command_extend:
        action: set cyl_retract_cmd off
        action: set cyl_extend_cmd on
    step wait_extend_feedback:
        wait: sensor_extend == true
        timeout: 800ms -> goto sensor_stuck_recovery
    step command_retract:
        action: set cyl_extend_cmd off
        action: set cyl_retract_cmd on
    step settle:
        delay: 120ms
    on_complete: goto ready

task sensor_stuck_recovery:
    step force_safe_state:
        action: set cyl_extend_cmd off
        action: set cyl_retract_cmd off
        action: set alarm_light on
    step wait_maintenance_reset:
        wait: maintenance_reset == true
        allow_indefinite_wait: true
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
