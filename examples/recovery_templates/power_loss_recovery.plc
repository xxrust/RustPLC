[topology]


device start_button: sensor {
    purpose: "操作员启动按钮，触发传送带送料流程",
    debounce: 20ms
}
device power_ok: sensor { purpose: "电源监测信号，掉电时触发安全停机和恢复流程" }
device station_sensor: sensor { purpose: "工位到位检测传感器，确认工件已输送到目标工位" }
device conveyor: motor { purpose: "传送带驱动电机，掉电时立即停止并等待电源恢复后重启" }
device alarm_light: solenoid_valve { purpose: "报警指示灯，掉电恢复期间持续点亮提示操作员" }

relation { from: start_button.out, to: plc_main.X0, via: reports_to }
relation { from: power_ok.out, to: plc_main.X1, via: reports_to }
relation { from: station_sensor.out, to: plc_main.X2, via: reports_to }
relation { from: plc_main.Y0, to: conveyor.cmd, via: driven_by }
relation { from: plc_main.Y1, to: alarm_light.coil, via: driven_by }

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [X0:digital:consumer, X1:digital:consumer, X2:digital:consumer, Y0:digital:producer, Y1:digital:producer] }
[constraints]

[tasks]

task cycle:
    step wait_power:
        wait: power_ok == true
        timeout: 200ms -> goto power_loss_recovery
    step feed_on:
        action: set conveyor.run on
    step wait_station:
        wait: station_sensor == true
        timeout: 1200ms -> goto power_loss_recovery
    step feed_off:
        action: set conveyor.run off
    on_complete: goto ready

task power_loss_recovery:
    step safe_shutdown:
        action: set conveyor.run off
        action: set alarm_light on
    step wait_power_restore:
        wait: power_ok == true
        timeout: 5000ms -> goto power_loss_recovery
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
