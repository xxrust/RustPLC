[topology]

device X0: digital_input
device X1: digital_input
device X2: digital_input
device Y0: digital_output
device Y1: digital_output

device start_button: sensor {
    debounce: 20ms
}
device power_ok: sensor
device station_sensor: sensor
device conveyor: motor
device alarm_light: solenoid_valve

relation { from: start_button.out, to: X0, via: reports_to }
relation { from: power_ok.out, to: X1, via: reports_to }
relation { from: station_sensor.out, to: X2, via: reports_to }
relation { from: Y0, to: conveyor.cmd, via: driven_by }
relation { from: Y1, to: alarm_light.coil, via: driven_by }

[constraints]

[tasks]

task cycle:
    step wait_power:
        wait: power_ok == true
        timeout: 200ms -> goto power_loss_recovery
    step feed_on:
        action: set conveyor on
    step wait_station:
        wait: station_sensor == true
        timeout: 1200ms -> goto power_loss_recovery
    step feed_off:
        action: set conveyor off
    on_complete: goto ready

task power_loss_recovery:
    step safe_shutdown:
        action: set conveyor off
        action: set alarm_light on
    step wait_power_restore:
        wait: power_ok == true
        timeout: 5000ms -> goto power_loss_recovery
    step clear_alarm:
        action: set alarm_light off
    on_complete: goto ready

task ready:
    step wait_start:
        wait: start_button == true
        allow_indefinite_wait: true
    on_complete: goto cycle
