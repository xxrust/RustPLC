[topology]

device AI0: analog_input { range: 0..360, unit: "deg", external: true }
device AO0: analog_output { range: 0..360, unit: "deg" }

cam_table shear_a: periodic [
    (0, 0),
    (120, 40),
    (240, 80),
    (360, 0),
]
cam_table shear_b: periodic [
    (0, 10),
    (180, 120),
    (360, 10),
]

device cam_xy: cam_coupling {
    master: AI0,
    slave: AO0,
    table: shear_a,
    interpolation: cubic_spline,
    gear_ratio: 1.0,
    phase_offset: 0.0,
    following_error_limit: 5.0,
    slave_feedback: AI0,
}

[constraints]

causality: AI0 -> cam_xy -> AO0
safety: cam_xy.fault.on conflicts_with cam_xy.engage.on

[tasks]

task main:
    step engage:
        action: cam_engage cam_xy
    step phase_track:
        action: cam_phase cam_xy 12.0
    step wait_cut_window:
        wait: cam_xy.master_pos > 30
        timeout: 200ms -> goto done
    step switch_profile:
        action: cam_switch cam_xy shear_b
    step settle:
        wait: cam_xy.master_pos > 120
        timeout: 200ms -> goto done
    on_complete: goto done

task done:
    step halt:
