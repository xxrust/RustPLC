[topology]

# Dual-axis minimal example for the RP2040 motion subsystem.
#
# It demonstrates the current dev-stage convention:
# - Commands are written to virtual outputs (Y24/Y25/AO24 and Y26/Y27/AO26)
# - Feedback is read from virtual inputs (AI24/X24 and AI26/X26)
# - Scenarios drive the external feedback to exercise nominal + fault paths

# Physical IO (channel IDs only; bind to "virtual" in io_map.toml for motion channels)
device AO24: analog_output { purpose: "axis0 速度指令输出，写入步进频率（steps/s）驱动 X 轴运动",  range: 0..20000, unit: "step_s" } # axis0 vel_cmd_sps (virtual)
device AO26: analog_output { purpose: "axis1 速度指令输出，写入步进频率（steps/s）驱动 Y 轴运动",  range: 0..20000, unit: "step_s" } # axis1 vel_cmd_sps (virtual)
device AI24: analog_input { purpose: "axis0 编码器计数反馈，用于判断 X 轴是否到达目标步数",  range: 0..4000000, unit: "count", external: true } # axis0 count
device AI26: analog_input { purpose: "axis1 编码器计数反馈，用于判断 Y 轴是否到达目标步数",  range: 0..4000000, unit: "count", external: true } # axis1 count




device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [Y24:digital:producer, Y25:digital:producer, AO24:analog:producer, Y26:digital:producer, Y27:digital:producer, AO26:analog:producer, AI24:analog:consumer, X24:digital:consumer, AI26:analog:consumer, X26:digital:consumer] }
[constraints]

[tasks]

task cycle:
  step enable_axes:
    action: set Y24 on
    action: set Y26 on

  step set_dir_forward:
    action: set Y25 on
    action: set Y27 on

  step start_move:
    action: set_analog AO24 8000
    action: set_analog AO26 6000

  step wait_dir_feedback:
    wait: X24 == true
    timeout: 200ms -> goto fault

  step wait_axis0_count:
    wait: AI24 >= 20000
    timeout: 1500ms -> goto fault

  step wait_axis1_count:
    wait: AI26 >= 15000
    timeout: 1500ms -> goto fault

  step stop:
    action: set_analog AO24 0
    action: set_analog AO26 0
    action: set Y24 off
    action: set Y26 off

  on_complete: goto done

task fault:
  step safe_stop:
    action: set_analog AO24 0
    action: set_analog AO26 0
    action: set Y24 off
    action: set Y26 off

  step log:
    action: log "fault: timeout waiting for motion feedback"

  on_complete: goto done

task done:
  step hold:
    allow_indefinite_wait: true
