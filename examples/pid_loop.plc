[topology]
device AI0: analog_input { purpose: "AI0: 模拟量输入采集点",  range: 0..100, unit: "bar", external: true }
device AO0: analog_output { purpose: "AO0: 模拟量输出控制点",  range: 0..100, unit: "%" }

device loop_pressure: pid {
    purpose: "loop_pressure: PID 控制回路",
    pv: AI0,
    sp: 60bar,
    kp: 2.0,
    ki: 0.5,
    kd: 0.0,
    out: AO0,
    period_ms: 100,
    limit: 0..100
}

device plc_main: plc { purpose: "控制器本体与工艺 I/O 端口映射",  ports: [AI0:analog:consumer, AO0:analog:producer] }
[constraints]

[tasks]
task main:
    step hold:
