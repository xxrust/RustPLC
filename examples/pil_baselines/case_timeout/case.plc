[topology]


device start_button: sensor { purpose: "启动信号输入，用于触发超时基线测试场景" }

relation { from: start_button.out, to: plc_main.X0, via: reports_to }

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    model_ref: openplc_softplc
}
[constraints]

[tasks]

task main:
    step wait_start:
        wait: start_button == true
        timeout: 2ms -> goto fault

    step ok:
        action: log "start pressed"

    on_complete: goto main

task fault:
    step alarm:
        action: log "timeout"
    on_complete: goto main
