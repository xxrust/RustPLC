[topology]


device start_button: sensor

relation { from: start_button.out, to: plc_main.X0, via: reports_to }

device plc_main: plc { ports: [X0:digital:consumer] }
[constraints]

[tasks]

task main:
    step wait_start:
        wait: start_button == true
        timeout: 2ms -> goto fault

    step ok:
        action: log "start pressed"

    on_complete: goto main

task fault:
    step alarm:
        action: log "timeout"
    on_complete: goto main
