[topology]

# This file only exists to make the scale baseline selectable in Web UI project list.
# The UI will load `examples/topology_perf_500.topology.json` first for this project id.
device bootstrap_signal: digital_input { purpose: "占位启动信号，使 500 节点拓扑性能基线文件可被 Web UI 项目列表加载" }

[constraints]

[tasks]

task idle:
    step hold:
        wait: bootstrap_signal == false
        allow_indefinite_wait: true
