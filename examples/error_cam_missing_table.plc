[topology]

device axis_master: servo_drive { response_time: 20ms }
device axis_slave: servo_drive { response_time: 20ms }
device cam_xy: cam_coupling {
    master: axis_master,
    slave: axis_slave,
    table: missing_table,
}

[constraints]

[tasks]

task main:
    step run:
        action: cam_engage cam_xy
