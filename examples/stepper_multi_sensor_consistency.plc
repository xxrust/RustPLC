[topology]

# Minimal, runnable example showing multi-sensor consistency handling:
# - Encoder-derived position (axis_count) + external distance sensor (laser_pos_mm)
# - Drive-layer health signals exposed to DSL: pos_consistent (bool) + sensor_fault_code (enum)
# - If consistency fails: enter a degraded state (stop motion + wait for recovery)
# - If sensor_fault_code is non-zero: enter fault (requires manual attention)

# Physical IO

# External feedback provided by the drive / board layer
device AI0: analog_input { purpose: "编码器计数快照，驱动层提供的轴位置原始反馈",  range: 0..4000000, unit: "count", external: true } # encoder count snapshot
device AI1: analog_input { purpose: "激光测距快照，与编码器交叉验证位置一致性",  range: 0..2000, unit: "mm", external: true } # laser distance snapshot
device AI2: analog_input { purpose: "传感器健康码，0=正常，非零表示激光丢失或位置不一致等故障",  range: 0..5, unit: "code", external: true } # 0=ok, 1=laser dropout, 2=pos mismatch, ...

# Logical aliases for scenarios/tests.
device axis_count: analog_input { purpose: "AI0 的逻辑别名，供场景/测试直接按名称驱动编码器计数",  range: 0..4000000, unit: "count" }
device laser_pos_mm: analog_input { purpose: "AI1 的逻辑别名，供场景/测试直接按名称驱动激光测距值",  range: 0..2000, unit: "mm" }
device sensor_fault_code: analog_input { purpose: "AI2 的逻辑别名，供场景/测试注入传感器故障码",  range: 0..5, unit: "code" }

# Logical devices
device axis_x: motor {
    purpose: "X 轴步进电机，位置一致性未建立时禁止使能",
    ramp_time: 10ms
}

device dir_positive: digital_output { purpose: "X 轴正方向运动指令输出" }

device move_cmd: digital_output { purpose: "X 轴运动启动/停止指令输出" }

device inpos_x: sensor { purpose: "X 轴到位信号，驱动器反馈轴已到达目标位置" }
device alarm_x: sensor { purpose: "X 轴驱动器报警信号，报警未清除时禁止使能轴" }

device pos_consistent: digital_input { purpose: "编码器与激光测距位置一致性标志，false 时进入降级状态禁止运动" }

relation { from: plc_main.Y1, to: axis_x.cmd, via: driven_by }
relation { from: axis_x.position_ok, to: inpos_x.sense, via: detects }
relation { from: inpos_x.out, to: plc_main.X0, via: reports_to }
relation { from: axis_x.alarm, to: alarm_x.sense, via: detects }
relation { from: alarm_x.out, to: plc_main.X1, via: reports_to }

device plc_main: plc {
    purpose: "控制器本体与工艺 I/O 端口映射",
    model_ref: openplc_softplc
}
[constraints]

# Basic: do not enable the axis while drive is alarming.
safety: axis_x.run.on requires alarm_x.off
    reason: "Drive alarm must be cleared before enabling axis"

[tasks]

task cycle:
    # Fault scenario hook: alarm can be driven by scenarios.
    step wait_alarm_clear:
        wait: alarm_x == false
        timeout: 200ms -> goto fault

    # If the distance sensor reports an explicit fault, treat it as a hard fault.
    step check_sensor_fault:
        if: sensor_fault_code == 0 goto cycle.check_consistency else: goto fault

    # If consistency is not established, enter a degraded state before enabling motion.
    step check_consistency:
        if: pos_consistent == true goto cycle.enable_axis else: goto degraded

    step enable_axis:
        action: set axis_x.run on

    step set_dir_positive:
        action: set dir_positive on

    step start_move:
        action: set move_cmd on

    # While moving, continuously accept either "target reached" or "health degraded".
    step wait_target_or_degrade:
        wait: axis_count >= 120000 OR pos_consistent == false OR sensor_fault_code != 0
        timeout: 3000ms -> goto fault

    step decide_after_move_watch:
        if: sensor_fault_code == 0 goto cycle.decide_after_consistency else: goto fault

    step decide_after_consistency:
        if: pos_consistent == true goto cycle.wait_inpos_or_degrade else: goto degraded

    step wait_inpos_or_degrade:
        wait: inpos_x == true OR pos_consistent == false OR sensor_fault_code != 0
        timeout: 1000ms -> goto fault

    step decide_after_inpos_watch:
        if: sensor_fault_code == 0 goto cycle.decide_after_inpos_consistency else: goto fault

    step decide_after_inpos_consistency:
        if: pos_consistent == true goto cycle.stop_move else: goto degraded

    step stop_move:
        action: set move_cmd off

    on_complete: goto idle

task degraded:
    step safe_stop:
        action: set move_cmd off
        action: set axis_x.run off
    step log:
        action: log "degraded: multi-sensor inconsistency detected; motion inhibited"
    step wait_recover:
        wait: pos_consistent == true AND sensor_fault_code == 0
        timeout: 2000ms -> goto fault
    on_complete: goto idle

task fault:
    step safe_stop:
        action: set move_cmd off
        action: set axis_x.run off
    step log:
        action: log "fault: sensor fault/alarm/timeout"
    on_complete: goto idle

task idle:
    step hold:
        allow_indefinite_wait: true
