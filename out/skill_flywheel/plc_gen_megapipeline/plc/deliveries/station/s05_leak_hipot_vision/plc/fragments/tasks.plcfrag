task s05_validation_cycle:
    step wait_start:
        wait: start_button == true
        timeout: 100ms -> goto fault.reject_start

    step load_module:
        effect: acquire holder inspection_carrier from s05_infeed
        action: extend cyl_s05_clamp

    step leak_and_hipot:
        effect: transfer from inspection_carrier to seal_chamber
        effect: acquire holder inspection_carrier from seal_chamber
        action: set motor_s05_index.cmd on
        delay: 60ms

    step vision_release:
        effect: transfer from inspection_carrier to hipot_cell
        effect: acquire holder inspection_carrier from hipot_cell
        delay: 60ms

    step handoff_validated:
        effect: transfer from inspection_carrier to s05_outfeed
        effect: finish workpiece at s05_outfeed as validated
        action: set motor_s05_index.cmd off
        action: retract cyl_s05_clamp

    on_complete: goto done.halt

task fault:
    step reject_start:
        effect: transfer from s05_infeed to s05_reject
        effect: finish workpiece at s05_reject as rejected

    on_complete: goto done.halt

task done:
    step halt:
        action: log "s05 cycle complete"
