task s03_tab_prep_cycle:
    step wait_start:
        wait: start_button == true
        timeout: 100ms -> goto fault.reject_start

    step load_module:
        effect: acquire holder tab_grip from infeed_s02
        action: extend cyl_s03_clamp

    step feed_tab_stock:
        effect: transfer from tab_grip to tab_prep_buffer
        effect: acquire holder tab_grip from tab_prep_buffer
        action: set motor_s03_feed.cmd on
        delay: 60ms

    step align_tab:
        effect: transfer from tab_grip to tab_prep_clamp
        effect: acquire holder tab_grip from tab_prep_clamp
        delay: 60ms

    step handoff_prepared:
        effect: transfer from tab_grip to tab_prep_out
        effect: finish workpiece at tab_prep_out as tab_prepared
        action: set motor_s03_feed.cmd off
        action: retract cyl_s03_clamp

    on_complete: goto done.halt

task fault:
    step reject_start:
        effect: transfer from infeed_s02 to tab_reject
        effect: finish workpiece at tab_reject as rejected

    on_complete: goto done.halt

task done:
    step halt:
        action: log "s03 cycle complete"
