device plc_main: plc {
    purpose: "S03 busbar tab prep controller"
    model_ref: openplc_softplc
}

device start_button: sensor {
    purpose: "S03 cycle start request"
    subtype: "push_button"
    debounce: 20ms
}

device valve_s03_clamp: solenoid_valve {
    purpose: "S03 tab clamp valve"
    response_time: 20ms
}

device cyl_s03_clamp: cylinder {
    purpose: "S03 tab clamp cylinder"
}

device motor_s03_feed: motor {
    purpose: "S03 tab feed motor"
}

workpiece battery_module_pack: workpiece_type {
    normal_terminal_states: [tab_prepared]
    abnormal_terminal_states: [rejected]
    ingress_sites: [infeed_s02]
    normal_egress_sites: [tab_prep_out]
    abnormal_egress_sites: [tab_reject]
}

location infeed_s02: workpiece_location { capacity: 1 }
location tab_prep_buffer: workpiece_location { capacity: 1 }
location tab_prep_clamp: workpiece_location { capacity: 1 }
location tab_prep_out: workpiece_location { capacity: 1 }
location tab_reject: workpiece_location { capacity: 1 }
holder tab_grip: workpiece_holder { capacity: 1 }

relation { from: start_button.out, to: plc_main.X0, via: reports_to }
relation { from: plc_main.Y0, to: valve_s03_clamp.coil, via: driven_by }
relation { from: plc_main.Y1, to: motor_s03_feed.cmd, via: driven_by }
relation { from: valve_s03_clamp.out, to: cyl_s03_clamp.cmd, via: driven_by }
