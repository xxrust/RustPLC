task s06_packout_cycle:
    step wait_start:
        wait: start_button == true
        timeout: 100ms -> goto fault.reject_start

    step load_module:
        effect: acquire holder station_carrier from s06_infeed
        action: extend cyl_s06_pusher

    step apply_label:
        effect: transfer from station_carrier to label_stage
        effect: acquire holder station_carrier from label_stage
        action: set motor_s06_label.cmd on
        delay: 60ms

    step cure_and_verify:
        effect: transfer from station_carrier to uv_stage
        effect: acquire holder station_carrier from uv_stage
        delay: 60ms

    step packout:
        effect: transfer from station_carrier to s06_outfeed
        effect: finish workpiece at s06_outfeed as packed
        action: set motor_s06_label.cmd off
        action: retract cyl_s06_pusher

    on_complete: goto done.halt

task fault:
    step reject_start:
        effect: transfer from s06_infeed to s06_reject_lane
        effect: finish workpiece at s06_reject_lane as rejected

    on_complete: goto done.halt

task done:
    step halt:
        action: log "s06 cycle complete"
