task s02_alignment_cycle:
    step wait_start:
        wait: start_button == true
        timeout: 100ms -> goto fault.reject_start

    step load_stack:
        effect: acquire holder alignment_table from alignment_ready
        action: extend cyl_s02_clamp

    step preload_cells:
        effect: transfer from alignment_table to preload_table
        effect: acquire holder alignment_table from preload_table
        action: set motor_s02_align.cmd on
        delay: 60ms

    step align_cells:
        effect: transfer from alignment_table to vision_align
        effect: acquire holder alignment_table from vision_align
        delay: 60ms

    step handoff_loaded:
        effect: transfer from alignment_table to cell_loaded
        effect: finish workpiece at cell_loaded as aligned
        action: set motor_s02_align.cmd off
        action: retract cyl_s02_clamp

    on_complete: goto done.halt

task fault:
    step reject_start:
        effect: transfer from alignment_ready to alignment_reject
        effect: finish workpiece at alignment_reject as rejected

    on_complete: goto done.halt

task done:
    step halt:
        action: log "s02 cycle complete"
