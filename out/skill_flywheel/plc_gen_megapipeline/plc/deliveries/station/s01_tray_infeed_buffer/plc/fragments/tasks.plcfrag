task s01_buffer_cycle:
    step wait_start:
        wait: start_button == true
        timeout: 100ms -> goto fault.reject_start

    step load_tray:
        effect: acquire holder tray_bay from tray_pickup
        action: extend cyl_s01_clamp

    step seat_tray:
        effect: transfer from tray_bay to clamp_seat
        effect: acquire holder tray_bay from clamp_seat
        action: set motor_s01_buffer.cmd on
        delay: 60ms

    step align_buffer:
        effect: transfer from tray_bay to buffer_lane
        effect: acquire holder tray_bay from buffer_lane
        delay: 60ms

    step release_buffer:
        effect: transfer from tray_bay to buffer_ready
        effect: finish workpiece at buffer_ready as buffered
        action: set motor_s01_buffer.cmd off
        action: retract cyl_s01_clamp

    on_complete: goto done.halt

task fault:
    step reject_start:
        effect: transfer from tray_pickup to tray_reject
        effect: finish workpiece at tray_reject as rejected

    on_complete: goto done.halt

task done:
    step halt:
        action: log "s01 cycle complete"
