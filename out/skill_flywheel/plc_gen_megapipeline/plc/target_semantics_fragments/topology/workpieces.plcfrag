workpiece battery_module_pack: workpiece_type {
    normal_terminal_states: [packed]
    abnormal_terminal_states: [rejected]
    ingress_sites: [line_infeed]
    normal_egress_sites: [line_packout]
    abnormal_egress_sites: [line_reject]
}

location line_infeed: workpiece_location { capacity: 1 }
location line_packout: workpiece_location { capacity: 1 }
location line_reject: workpiece_location { capacity: 1 }

