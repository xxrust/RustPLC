task station_01_infeed_buffer:
    step entry_window:
        wait: start_button == true
        timeout: 1000ms -> goto line_fault.line_start_timeout

    step load_position:
        effect: acquire holder holder_s01 from line_infeed
        action: extend cyl_s01_mag_pick

    step process_position:
        effect: transfer from holder_s01 to s01_mag_pick
        effect: acquire holder holder_s01 from s01_mag_pick
        action: set motor_s01_buffer_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s01 to s01_tray_scan
        effect: acquire holder holder_s01 from s01_tray_scan
        delay: 60ms

    step handoff:
        effect: transfer from holder_s01 to s01_transfer_out
        action: set motor_s01_buffer_01.cmd off
        action: retract cyl_s01_mag_pick

    step cycle_count_update:
        action: compute s01_cycle_counter = s01_cycle_counter + 1.0

    step cycle_gate:
        wait: s01_cycle_counter >= 2.0
        timeout: 20ms -> goto station_01_infeed_buffer.entry_window

    on_complete: goto done.halt

task station_02_cell_loading_alignment:
    step entry_window:
        delay: 180ms

    step load_position:
        effect: acquire holder holder_s02 from s01_transfer_out
        action: extend cyl_s02_cell_clamp

    step process_position:
        effect: transfer from holder_s02 to s02_cell_pick
        effect: acquire holder holder_s02 from s02_cell_pick
        action: set motor_s02_orient_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s02 to s02_orientation
        effect: acquire holder holder_s02 from s02_orientation
        delay: 60ms

    step handoff:
        effect: transfer from holder_s02 to s02_transfer_out
        action: set motor_s02_orient_01.cmd off
        action: retract cyl_s02_cell_clamp

    step cycle_count_update:
        action: compute s02_cycle_counter = s02_cycle_counter + 1.0

    step cycle_gate:
        wait: s02_cycle_counter >= 2.0
        timeout: 20ms -> goto station_02_cell_loading_alignment.entry_window

    on_complete: goto done.halt

task station_03_busbar_tab_prep:
    step entry_window:
        delay: 360ms

    step load_position:
        effect: acquire holder holder_s03 from s02_transfer_out
        action: extend cyl_s03_tab_clamp

    step process_position:
        effect: transfer from holder_s03 to s03_busbar_pick
        effect: acquire holder holder_s03 from s03_busbar_pick
        action: set motor_s03_feed_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s03 to s03_tab_form
        effect: acquire holder holder_s03 from s03_tab_form
        delay: 60ms

    step handoff:
        effect: transfer from holder_s03 to s03_transfer_out
        action: set motor_s03_feed_01.cmd off
        action: retract cyl_s03_tab_clamp

    step cycle_count_update:
        action: compute s03_cycle_counter = s03_cycle_counter + 1.0

    step cycle_gate:
        wait: s03_cycle_counter >= 2.0
        timeout: 20ms -> goto station_03_busbar_tab_prep.entry_window

    on_complete: goto done.halt

task station_04_laser_weld_cooling:
    step entry_window:
        delay: 540ms

    step load_position:
        effect: acquire holder holder_s04 from s03_transfer_out
        action: extend cyl_s04_weld_clamp

    step process_position:
        effect: transfer from holder_s04 to s04_entry_clamp
        effect: acquire holder holder_s04 from s04_entry_clamp
        action: set motor_s04_cool_fan_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s04 to s04_left_weld
        effect: acquire holder holder_s04 from s04_left_weld
        delay: 60ms

    step handoff:
        effect: transfer from holder_s04 to s04_cool_out
        action: set motor_s04_cool_fan_01.cmd off
        action: retract cyl_s04_weld_clamp

    step cycle_count_update:
        action: compute s04_cycle_counter = s04_cycle_counter + 1.0

    step cycle_gate:
        wait: s04_cycle_counter >= 2.0
        timeout: 20ms -> goto station_04_laser_weld_cooling.entry_window

    on_complete: goto done.halt

task station_05_leak_hipot_vision:
    step entry_window:
        delay: 720ms

    step load_position:
        effect: acquire holder holder_s05 from s04_cool_out
        action: extend cyl_s05_seal_clamp

    step process_position:
        effect: transfer from holder_s05 to s05_seal_load
        effect: acquire holder holder_s05 from s05_seal_load
        action: set motor_s05_index_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s05 to s05_vacuum_test
        effect: acquire holder holder_s05 from s05_vacuum_test
        delay: 60ms

    step handoff:
        effect: transfer from holder_s05 to s05_vision_out
        action: set motor_s05_index_01.cmd off
        action: retract cyl_s05_seal_clamp

    step cycle_count_update:
        action: compute s05_cycle_counter = s05_cycle_counter + 1.0

    step cycle_gate:
        wait: s05_cycle_counter >= 2.0
        timeout: 20ms -> goto station_05_leak_hipot_vision.entry_window

    on_complete: goto done.halt

task station_06_label_packout_sort:
    step entry_window:
        delay: 900ms

    step load_position:
        effect: acquire holder holder_s06 from s05_vision_out
        action: extend cyl_s06_box_pusher

    step process_position:
        effect: transfer from holder_s06 to s06_label_print
        effect: acquire holder holder_s06 from s06_label_print
        action: set motor_s06_pack_01.cmd on
        delay: 60ms

    step align_and_release:
        effect: transfer from holder_s06 to s06_qr_verify
        effect: acquire holder holder_s06 from s06_qr_verify
        delay: 60ms

    step handoff:
        effect: transfer from holder_s06 to line_packout
        effect: finish workpiece at line_packout as packed
        action: set motor_s06_pack_01.cmd off
        action: retract cyl_s06_box_pusher

    step cycle_count_update:
        action: compute s06_cycle_counter = s06_cycle_counter + 1.0

    step cycle_gate:
        wait: s06_cycle_counter >= 2.0
        timeout: 20ms -> goto station_06_label_packout_sort.entry_window

    on_complete: goto done.halt

task reserve_loader:
    step wait_start:
        wait: start_button == true
        timeout: 1000ms -> goto line_fault.line_start_timeout

    step release_window:
        delay: 40ms

    step pick_reserve:
        effect: acquire holder line_loader from line_infeed_reserve

    step release_reserve:
        effect: transfer from line_loader to line_infeed

    on_complete: goto done.halt
