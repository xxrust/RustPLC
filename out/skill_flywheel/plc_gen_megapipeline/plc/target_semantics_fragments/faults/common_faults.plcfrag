task line_fault:
    step line_start_timeout:
        action: set motor_s01_buffer_01.cmd off
        action: set motor_s02_orient_01.cmd off
        action: set motor_s03_feed_01.cmd off
        action: set motor_s04_cool_fan_01.cmd off
        action: set motor_s05_index_01.cmd off
        action: set motor_s06_pack_01.cmd off

    on_complete: goto done.halt

task done:
    step halt:
